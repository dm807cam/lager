# Public address of the platform (login, dashboard, API, MCP). For OAuth it must be https or localhost.
LAGER_PUBLIC_URL=http://localhost:8080
# Domain of the apps: every instance runs at <slug>.<domain> and needs wildcard DNS (*.domain).
LAGER_APPS_DOMAIN=apps.localhost
# Email address of the first administrator, created on first start.
LAGER_ADMIN_EMAIL=admin@example.com
# Password of the first administrator, at least 10 characters (only read on first start; the line can be removed afterwards).
# Lager refuses to start with this example value unless LAGER_PUBLIC_URL is localhost, *.localhost, 127.0.0.1 or [::1].
LAGER_ADMIN_PASSWORD=change-me-please
# Language of the pages and mails when neither the account, a cookie nor the browser names one: en, de, fr or es.
LAGER_DEFAULT_LOCALE=en
# SMTP access for mail (verification, password reset, invitations), e.g. smtps://user:password@smtp.example.com:465; empty = no mail is sent.
LAGER_SMTP_URL=
# Sender of the mails, in quotes, e.g. LAGER_MAIL_FROM="Lager <lager@example.com>"; empty = Lager <no-reply@host of LAGER_PUBLIC_URL>.
LAGER_MAIL_FROM=
# Maximum size of an instance's data in MiB (integer, 1 or more).
LAGER_INSTANCE_QUOTA_MB=50
# How many days deleted instances and apps stay in the trash (<data directory>/trash) before Lager removes them for good; 0 = never clean up.
LAGER_TRASH_DAYS=30
# Data directory (database, versions, keys); /data in the container.
LAGER_DATA_DIR=/data
# Port the server listens on (always 8080 by default, independent of LAGER_PUBLIC_URL).
LAGER_PORT=8080
# Address the server binds to; empty = every interface (needed in the container). Without Docker and with the proxy on the same machine: 127.0.0.1.
LAGER_HOST=
# true = one log line per request (time, client address, method, host and path, status, duration).
LAGER_ACCESS_LOG=false
# Secret key for sessions and for encrypting stored AI provider keys; leave empty to generate one and store it in the data directory.
# If you set it, use at least 32 random characters (for example: openssl rand -hex 32); Lager refuses to start with a shorter one.
LAGER_SECRET=
# How many data snapshots are kept per instance.
LAGER_SNAPSHOT_KEEP=20
# How many proxy hops in front of Lager are trusted: false or 0 = none (reachable directly from the internet),
# true = 1 (one reverse proxy, the default) or a number for several proxies in a row.
LAGER_TRUST_PROXY=true
