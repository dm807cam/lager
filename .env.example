# Öffentliche Adresse der Plattform (Login, Dashboard, API, MCP). Für OAuth muss sie https oder localhost sein.
LAGER_PUBLIC_URL=http://localhost:8080
# Domain der Apps: jede Instanz läuft unter <slug>.<Domain>, braucht Wildcard-DNS (*.Domain).
LAGER_APPS_DOMAIN=apps.localhost
# E-Mail-Adresse des Admin-Kontos, das beim ersten Start angelegt wird.
LAGER_ADMIN_EMAIL=admin@example.com
# Passwort des Admin-Kontos (wird nur beim ersten Start gelesen; danach kann die Zeile entfallen).
LAGER_ADMIN_PASSWORD=bitte-aendern
# Datenverzeichnis (Datenbank, Versionen, Schlüssel); im Container /data.
LAGER_DATA_DIR=/data
# Port, auf dem der Server lauscht (Standard immer 8080, unabhängig von LAGER_PUBLIC_URL).
LAGER_PORT=8080
# Geheimer Schlüssel für Sitzungen; leer lassen, dann wird er erzeugt und im Datenverzeichnis gespeichert.
LAGER_SECRET=
# Wie viele Daten-Schnappschüsse pro Instanz aufbewahrt werden.
LAGER_SNAPSHOT_KEEP=20
# Wie vielen Proxy-Stationen vor Lager vertraut wird: false oder 0 = keiner (direkt aus dem Internet erreichbar),
# true = 1 (ein Reverse Proxy, Standard) oder eine Zahl für mehrere Proxys hintereinander.
LAGER_TRUST_PROXY=true
